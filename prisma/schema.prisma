  new_value  String?
  employees  employees? @relation(fields: [actor_id], references: [id], onUpdate: NoAction)

  @@index([actor_id], map: "idx_audit_log_actor")
  @@index([module], map: "idx_audit_log_module")
  @@index([target_id], map: "idx_audit_log_target")
}

model content_batches {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
