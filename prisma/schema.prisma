datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model activity_log {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id   String?    @db.Uuid
  module     String
  action     String
  target_id  String     @db.Uuid
  old_value  String?
  new_value  String?
  details    Json?
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  employees  employees? @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([actor_id], map: "idx_activity_log_actor")
  @@index([created_at(sort: Desc)], map: "idx_activity_log_created")
  @@index([module, target_id], map: "idx_activity_log_module_target")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model advances {
  id                                        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id                               String     @db.Uuid
  amount                                    Decimal    @db.Decimal(10, 2)
  advance_date                              DateTime   @db.Date
  note                                      String?
  payment_status                            String     @default("Unpaid")
  created_by                                String?    @db.Uuid
  created_at                                DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at                                DateTime?  @default(now()) @db.Timestamptz(6)
  expense_id                                String?    @db.Uuid
  employees_advances_created_byToemployees  employees? @relation("advances_created_byToemployees", fields: [created_by], references: [id], onUpdate: NoAction)
  employees_advances_employee_idToemployees employees  @relation("advances_employee_idToemployees", fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  expenses                                  expenses?  @relation(fields: [expense_id], references: [id], onUpdate: NoAction)

  @@index([advance_date], map: "idx_advances_date")
  @@index([employee_id], map: "idx_advances_employee")
}

model app_settings {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  whatsapp_enabled     Boolean?  @default(false)
  auto_assign_problems Boolean?  @default(true)
  smart_notifications  Boolean?  @default(true)
  quick_entry_default  Boolean?  @default(false)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model attendance {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id       String?             @db.Uuid
  date              DateTime            @db.Date
  clock_in          DateTime?           @db.Timestamptz(6)
  clock_out         DateTime?           @db.Timestamptz(6)
  status            String?             @default("present")
  notes             String?
  employees         employees?          @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attendance_breaks attendance_breaks[]

  @@unique([employee_id, date])
  @@index([employee_id, date], map: "idx_attendance_employee_date")
}

model attendance_breaks {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attendance_id String?     @db.Uuid
  start_time    DateTime    @db.Timestamptz(6)
  end_time      DateTime?   @db.Timestamptz(6)
  created_at    DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?   @default(now()) @db.Timestamptz(6)
  attendance    attendance? @relation(fields: [attendance_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([attendance_id], map: "idx_attendance_breaks_attendance_id")
}

model audit_log {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id   String?    @db.Uuid
  action     String
  module     String?
  target_id  String?    @db.Uuid
  details    Json?      @default("{}")
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
